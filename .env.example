# ====================================================================
# Discord Transcriber Bot Configuration
# ====================================================================

# 1. Discord Bot Token (From https://discord.com/developers/applications)
# Required Privileged Intents: Message Content Intent, Server Members Intent
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 2. Command Prefix for traditional text commands (e.g. !join, !leave)
COMMAND_PREFIX=!

# 3. Default Channel Name where threads will be created per server
DEFAULT_TRANSCRIPT_CHANNEL_NAME=voice-transcripts

# 4. Speech-to-Text Provider: 'openai' or 'deepgram'
STT_PROVIDER=openai

# 5. API Keys (Fill the one corresponding to your STT_PROVIDER)
OPENAI_API_KEY=your_openai_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# 6. STT Model Settings
# OpenAI model: 'whisper-1'
# Deepgram model: 'nova-2'
OPENAI_WHISPER_MODEL=whisper-1
DEEPGRAM_MODEL=nova-2
LANGUAGE=en

# 7. Audio Processing & Speech Detection (in seconds)
CHUNK_DURATION_SECONDS=3.5
SILENCE_TIMEOUT_SECONDS=1.2

# 8. Audible Voice Announcement when joining/leaving VC (true/false)
PLAY_VOICE_ANNOUNCEMENT=true
